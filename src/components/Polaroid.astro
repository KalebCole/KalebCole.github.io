---
interface Props {
  src?: string;
  alt?: string;
}
const {
  src = '/me.jpg',
  alt = 'Kaleb Cole smiling in a crowded concert arena',
} = Astro.props;
---
<figure class="portrait-mount">
  <picture>
    <source
      type="image/webp"
      srcset="/me-300.webp 300w, /me-600.webp 600w"
      sizes="(max-width: 759px) 190px, 300px"
    />
    <img src={src} alt={alt} width="600" height="600" fetchpriority="high" />
  </picture>
  <figcaption>Still figuring it out in public.</figcaption>
</figure>