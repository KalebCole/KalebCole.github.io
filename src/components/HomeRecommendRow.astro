---
import type { Recommend } from '../lib/recommends';

interface Props {
  item: Recommend;
}

const { item } = Astro.props;
const mediumLabels = {
  read: 'Read',
  watch: 'Watch',
  listen: 'Listen',
};
const formattedDate = item.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const source = item.data.source ?? item.data.author;
---
<article class="home-recommendation-row" data-home-recommendation data-medium={item.data.medium}>
  <div class="home-recommendation-copy">
    <h3 class="home-recommendation-title">
      <a href={item.data.url}>
        {item.data.title}<span aria-hidden="true"> ↗</span><span class="sr-only"> (external site)</span>
      </a>
    </h3>
    {item.data.take && (
      <p class="home-recommendation-take">
        <span>My thoughts</span>
        {item.data.take}
      </p>
    )}
    <p class="home-feed-meta">
      <span>{mediumLabels[item.data.medium]}</span>
      {source && <span>{source}</span>}
      <time datetime={item.data.date.toISOString()}>{formattedDate}</time>
    </p>
  </div>
</article>
