---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [pinned, ...archive] = posts;

const groups = new Map<number, typeof archive>();
for (const post of archive) {
  const year = post.data.date.getUTCFullYear();
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
const years = [...groups.keys()];
---
<Layout title="Writing — Kaleb Cole">
  <main id="main-content" class="site-shell writing-page">
    <header class="page-heading">
      <h1>Writing</h1>
      <p>Notes, essays, and half-finished thoughts.</p>
    </header>

    {pinned ? (
      <article class="pinned-writing">
        <div class="pinned-copy">
          <p class="meta-line">
            <time datetime={pinned.data.date.toISOString()}>
              {pinned.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
            {pinned.data.tags.length > 0 && <span>{pinned.data.tags.join(' · ')}</span>}
          </p>
          <h2><a href={`/blog/${pinned.id}`}>{pinned.data.title}</a></h2>
        </div>
        <aside class="note-mount" aria-label="Why this now">
          <strong>Why this now</strong>
          <p>{pinned.data.description}</p>
        </aside>
      </article>
    ) : (
      <p class="empty-state">Nothing here yet.</p>
    )}

    {archive.length > 0 && (
      <div class="writing-archive">
        {years.map((year) => (
          <section aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-heading">{year}</h2>
            <div class="writing-list">
              {groups.get(year)!.map((post) => (
                <article class="writing-row">
                  <div>
                    <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                    <p>{post.data.description}</p>
                  </div>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </main>
</Layout>