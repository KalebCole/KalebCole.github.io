---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';

const items = (await getCollection('recommends', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const required = items.filter((i) => i.data.required);
const recommended = items.filter((i) => !i.data.required);

const mediumMeta = {
  read:   { icon: '\u{1F4D6}', label: 'Read' },   // 📖
  watch:  { icon: '\u{25B6}',  label: 'Watch' },  // ▶
  listen: { icon: '\u{1F3A7}', label: 'Listen' }, // 🎧
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout
  title="Recommends — Kaleb Cole"
  description="Things worth your time — articles, videos, and audio Kaleb Cole recommends."
>
  <main class="wrap">
    <SiteNav />
    <h1>Recommends</h1>
    <p class="muted">
      Things I think are worth your time. Articles, talks, and audio, with a note on why.
      <a href="/recommends/rss.xml">RSS</a>
    </p>

    {required.length > 0 && (
      <section>
        <h2 class="rec-band">Required</h2>
        {required.map((item) => {
          const m = mediumMeta[item.data.medium];
          return (
            <article class="rec">
              {item.data.image && (
                <a href={item.data.url} class="rec-thumb-link" rel="noopener">
                  <img class="rec-thumb" src={item.data.image} alt="" loading="lazy" />
                </a>
              )}
              <div class="rec-body">
                <p class="rec-meta">
                  <span class={`badge badge-${item.data.medium}`}>{m.icon} {m.label}</span>
                  {item.data.source && <span> · {item.data.source}</span>}
                  <span> · {fmtDate(item.data.date)}</span>
                </p>
                <h3 class="rec-title">
                  <a href={item.data.url} rel="noopener">{item.data.title}</a>
                </h3>
                {item.data.author && <p class="rec-author">{item.data.author}</p>}
                <p class="rec-take">{item.data.take}</p>
                {item.data.tags.length > 0 && (
                  <p class="rec-tags">{item.data.tags.map((t) => <span class="tag">#{t}</span>)}</p>
                )}
              </div>
            </article>
          );
        })}
      </section>
    )}

    {recommended.length > 0 && (
      <section>
        <h2 class="rec-band">Also recommended</h2>
        {recommended.map((item) => {
          const m = mediumMeta[item.data.medium];
          return (
            <article class="rec">
              {item.data.image && (
                <a href={item.data.url} class="rec-thumb-link" rel="noopener">
                  <img class="rec-thumb" src={item.data.image} alt="" loading="lazy" />
                </a>
              )}
              <div class="rec-body">
                <p class="rec-meta">
                  <span class={`badge badge-${item.data.medium}`}>{m.icon} {m.label}</span>
                  {item.data.source && <span> · {item.data.source}</span>}
                  <span> · {fmtDate(item.data.date)}</span>
                </p>
                <h3 class="rec-title">
                  <a href={item.data.url} rel="noopener">{item.data.title}</a>
                </h3>
                {item.data.author && <p class="rec-author">{item.data.author}</p>}
                <p class="rec-take">{item.data.take}</p>
                {item.data.tags.length > 0 && (
                  <p class="rec-tags">{item.data.tags.map((t) => <span class="tag">#{t}</span>)}</p>
                )}
              </div>
            </article>
          );
        })}
      </section>
    )}

    {items.length === 0 && <p class="muted">Nothing here yet. Check back soon.</p>}
  </main>
</Layout>
