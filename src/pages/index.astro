---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Polaroid from '../components/Polaroid.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const homepageDescription = 'I share what interests me here, along with things that might help someone else learn.';
---
<Layout
  title="Kaleb Cole"
  description={homepageDescription}
  image="/social/homepage-v2.png"
  imageWidth={1200}
  imageHeight={630}
  imageAlt="Kaleb Cole smiling at a concert beside his name, homepage description, and open-tail KC mark."
  imageType="image/png"
>
  <main id="main-content" class="site-shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-intro">
        <h1 id="home-title">Hi, I’m Kaleb. I make things, write down what I learn, and follow whatever has me <span>curious</span> right now.</h1>
        <p>I’m a software engineer at Microsoft, building what interests me and designing how we work with agents. This is where I write through the ideas that get stuck in my head.</p>
      </div>
      <Polaroid />
    </section>

    <section class="recent-writing" aria-labelledby="recent-title">
      <div class="recent-heading">
        <h2 id="recent-title">Recent writing</h2>
      </div>
      <div class="writing-list">
        {recentPosts.map((post) => (
          <article class="writing-row">
            <div>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </article>
        ))}
        <a class="all-writing-link" href="/blog">All writing <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>