---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HomeRecommendRow from '../components/HomeRecommendRow.astro';
import HomeProjectPreview from '../components/HomeProjectPreview.astro';
import Polaroid from '../components/Polaroid.astro';
import { getPublishedRecommends } from '../lib/recommends';
import { HOMEPAGE_SOCIAL_IMAGE } from '../lib/social-image.mjs';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const HOME_RECOMMENDATION_LIMIT = 3;
const recentRecommendations = (await getPublishedRecommends()).slice(0, HOME_RECOMMENDATION_LIMIT);
const homepageDescription = 'I share what interests me here, along with things that might help someone else learn.';
---
<Layout
  title="Kaleb Cole"
  description={homepageDescription}
  {...HOMEPAGE_SOCIAL_IMAGE}
>
  <main id="main-content" class="site-shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <h1 id="home-title" class="home-heading"><span class="home-greeting">Hi, I’m Kaleb.</span> <span class="home-statement">I make things, write down what I learn, and follow whatever has me <span class="home-accent">curious</span> right now.</span></h1>
      <p class="home-subtitle">I’m a software engineer at Microsoft, building what interests me and designing how we work with agents.</p>
      <div class="home-actions" aria-label="Explore my work">
        <a class="home-action home-action-primary" href="/projects">See my projects</a>
        <a class="home-action" href="/blog">Read my writing</a>
      </div>
      <Polaroid />
    </section>

    <section class="recent-projects" aria-labelledby="recent-projects-title">
      <div class="recent-heading">
        <h2 id="recent-projects-title">Recent projects</h2>
      </div>
      <HomeProjectPreview />
      <a class="all-projects-link" href="/projects">All projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="recent-writing" aria-labelledby="recent-title">
      <div class="recent-heading">
        <h2 id="recent-title">Recent writing</h2>
      </div>
      <div class="writing-list">
        {recentPosts.map((post) => (
          <article class="writing-row">
            <div>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p class="writing-summary">{post.data.description}</p>
              <p class="home-feed-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </p>
            </div>
          </article>
        ))}
        <a class="all-writing-link" href="/blog">All writing <span aria-hidden="true">→</span></a>
      </div>
    </section>

    {recentRecommendations.length > 0 && (
      <section class="recent-recommendations" aria-labelledby="recent-recommendations-title">
        <div class="recent-heading">
          <h2 id="recent-recommendations-title">Recent recommendations</h2>
        </div>
        <div class="home-recommendation-list">
          {recentRecommendations.map((item) => <HomeRecommendRow item={item} />)}
          <a class="all-recommendations-link" href="/recommends">
            All recommendations <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
  </main>
</Layout>