---
import Layout from '../layouts/Layout.astro';

const timeline = [
  { title: 'Microsoft SWE', date: 'Aug 2025 → Present', desc: 'Cloud + AI, Seattle' },
  { title: 'RMIT University', date: 'Jul – Nov 2024', desc: 'Study Abroad, Melbourne' },
  { title: 'Microsoft Intern', date: 'May – Jul 2024', desc: 'SWE Intern, Redmond' },
  { title: 'JWAC / DoD', date: 'May – Aug 2023', desc: 'Student Trainee, IT' },
  { title: 'WVU Tech', date: 'Aug 2021 – May 2025', desc: 'B.S. Computer Science' },
];

const projects = [
  { title: 'Partiful CLI', desc: 'CLI for creating Partiful events. No browser needed.', lang: 'JavaScript', url: 'https://github.com/KalebCole/partiful-cli', span: 'md:col-span-2' },
  { title: 'Intake', desc: 'Content collectors + enrichment pipeline.', lang: 'Python', url: 'https://github.com/KalebCole/intake', span: '' },
  { title: 'Analog Routine Tracker', desc: 'PWA bridging analog and digital routine tracking with OCR.', lang: 'TypeScript', url: 'https://github.com/KalebCole/analog-routine-tracker', span: '' },
  { title: 'Campus Security System', desc: 'Dual auth: RFID triangulation + face recognition. Senior capstone.', lang: 'Python', url: 'https://github.com/KalebCole/Campus-Security-and-Evacuation-System', span: 'md:col-span-2' },
  { title: 'Voxii', desc: 'VR language learning app. Immersive conversational scenarios.', lang: 'C#', url: 'https://github.com/KalebCole/Voxii', span: '' },
];

const widgets = [
  { title: 'Spotify', subtitle: 'Now Playing', icon: '♪', text: 'Not connected yet' },
  { title: 'GitHub', subtitle: 'Recent Activity', icon: '◈', text: 'Connect to see contributions' },
  { title: 'Fitness', subtitle: 'This Week', icon: '▲', text: '—' },
];
---

<Layout title="Kaleb Cole">
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[#0a0a0a]/80 border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="#hero" class="font-display text-lg text-white">KC</a>
      <div class="flex gap-6 text-sm text-[#888]">
        <a href="#about" class="hover:text-accent transition-colors">About</a>
        <a href="#timeline" class="hover:text-accent transition-colors">Experience</a>
        <a href="#projects" class="hover:text-accent transition-colors">Projects</a>
        <a href="#contact" class="hover:text-accent transition-colors">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section id="hero" class="min-h-screen flex flex-col items-center justify-center px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-accent)_0%,_transparent_70%)] opacity-[0.07]"></div>
    <h1 class="font-display text-6xl sm:text-8xl md:text-9xl text-white tracking-tight relative hero-glow">
      Kaleb Cole
    </h1>
    <p class="mt-4 text-lg sm:text-xl text-[#888] tracking-wide">
      Software Engineer. Builder. Explorer.
    </p>
    <div class="mt-8 flex gap-5 text-[#666]">
      <a href="https://github.com/KalebCole" target="_blank" rel="noopener" class="hover:text-accent transition-colors" aria-label="GitHub">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://linkedin.com/in/kaleb-cole" target="_blank" rel="noopener" class="hover:text-accent transition-colors" aria-label="LinkedIn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:kalebcole2021@gmail.com" class="hover:text-accent transition-colors" aria-label="Email">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
      </a>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="font-display text-4xl text-white mb-12">About</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-2">
        <p class="text-[#aaa] text-lg leading-relaxed">
          I'm a software engineer who builds things that matter. Currently working on Cloud + AI at Microsoft in Seattle. I care about developer tools, automation, and making complex systems feel simple.
        </p>
        <p class="text-[#aaa] text-lg leading-relaxed mt-4">
          When I'm not shipping code, you'll find me exploring new cities, tinkering with side projects, or figuring out how to automate something that probably doesn't need automating.
        </p>
      </div>
      <div class="flex items-center justify-center">
        <div class="w-full aspect-square rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-[#555] text-sm">
          Photo
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section id="timeline" class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="font-display text-4xl text-white mb-12">Experience</h2>
    <div class="relative overflow-x-auto pb-4 -mx-6 px-6">
      <div class="flex gap-6 min-w-max relative">
        <!-- Connecting line -->
        <div class="absolute top-[3.25rem] left-0 right-0 h-px bg-white/10"></div>
        {timeline.map((item, i) => (
          <div class="relative w-64 shrink-0">
            <div class="w-3 h-3 rounded-full bg-accent border-2 border-[#0a0a0a] relative z-10 mb-6"></div>
            <div class="card p-5">
              <h3 class="font-display text-xl text-white">{item.title}</h3>
              <p class="text-accent text-sm mt-1">{item.date}</p>
              <p class="text-[#888] text-sm mt-2">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="font-display text-4xl text-white mb-12">Projects</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {projects.map((p) => (
        <a href={p.url} target="_blank" rel="noopener" class={`card p-6 group ${p.span}`}>
          <div class="flex items-start justify-between">
            <h3 class="font-display text-xl text-white group-hover:text-accent transition-colors">{p.title}</h3>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#555] group-hover:text-accent transition-colors shrink-0 mt-1"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
          </div>
          <p class="text-[#888] text-sm mt-2">{p.desc}</p>
          <span class="inline-block mt-4 text-xs px-2 py-1 rounded-full bg-accent/10 text-accent">{p.lang}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Live Widgets -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="font-display text-4xl text-white mb-12">Live</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {widgets.map((w) => (
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl text-accent">{w.icon}</span>
            <div>
              <h3 class="font-display text-lg text-white">{w.title}</h3>
              <p class="text-[#666] text-xs">{w.subtitle}</p>
            </div>
          </div>
          <p class="text-[#555] text-sm">{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact / Footer -->
  <footer id="contact" class="max-w-6xl mx-auto px-6 py-24 border-t border-white/5">
    <h2 class="font-display text-4xl text-white mb-8">Let's connect</h2>
    <div class="flex flex-wrap gap-6 text-[#aaa]">
      <a href="mailto:kalebcole2021@gmail.com" class="hover:text-accent transition-colors">kalebcole2021@gmail.com</a>
      <a href="https://github.com/KalebCole" target="_blank" rel="noopener" class="hover:text-accent transition-colors">GitHub</a>
      <a href="https://linkedin.com/in/kaleb-cole" target="_blank" rel="noopener" class="hover:text-accent transition-colors">LinkedIn</a>
    </div>
    <p class="mt-16 text-[#444] text-sm">© 2026 Kaleb Cole</p>
  </footer>
</Layout>

<style is:global>
  :root {
    --color-accent: #4ade80;
  }

  .font-display {
    font-family: 'Instrument Serif', serif;
  }

  .font-body {
    font-family: 'DM Sans', sans-serif;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .bg-accent {
    background-color: var(--color-accent);
  }

  .bg-accent\/10 {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .border-accent {
    border-color: var(--color-accent);
  }

  .card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  .card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 30px -10px color-mix(in srgb, var(--color-accent) 15%, transparent);
    transform: translateY(-2px);
  }

  .hero-glow {
    background: linear-gradient(135deg, #fff 0%, var(--color-accent) 50%, #fff 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-shift 6s ease infinite;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Selection */
  ::selection {
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }
</style>
